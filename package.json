{
  "name": "@ouigame/root",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild@>=0.17.0 <0.28.1": "^0.28.1",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "flatted@<3.4.2": "^3.4.2",
      "socket.io-parser@>=4.0.0 <4.2.7": "^4.2.7",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "proxy-addr@<2.0.8": "^2.0.8",
      "engine.io@<6.6.11": "^6.6.11",
      "ip-address@<=10.3.0": "^10.3.1",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "postcss@<=8.5.17": "^8.5.18",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<=4.28.6": "^4.28.7",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0"
    }
  },
  "scripts": {
    "all": "pnpm install && pnpm dev",
    "dev": "sh scripts/ensure-postgres.sh && turbo run dev",
    "dev:api": "sh scripts/ensure-postgres.sh && pnpm --filter @ouigame/api dev",
    "dev:web": "pnpm --filter @ouigame/web dev",
    "build": "turbo run build",
    "start": "tsx apps/api/scripts/ensure-schema.ts && tsx apps/api/server.ts",
    "test": "pnpm --filter @ouigame/shared build && jest",
    "test:watch": "jest --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:coverage": "pnpm --filter @ouigame/shared build && jest --coverage",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && pnpm --filter @ouigame/web lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:ensure": "tsx apps/api/scripts/ensure-schema.ts",
    "db:migrate-data": "tsx apps/api/scripts/migrate_data.ts",
    "set-admin": "tsx apps/api/scripts/set-admin.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/web/**/*.{js,jsx,ts,tsx,css,html}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@ouigame/config-ts": "workspace:*",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.39",
    "@types/node": "^24.12.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.1.7",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "pg": "^8.21.0",
    "prettier": "^3.9.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
