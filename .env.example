# Copy this file to `.env` and fill in any blanks.
# The defaults below match the local Docker Postgres dev setup (see
# database_setup.txt). `.env` itself is gitignored — never commit real secrets.

# Express / Socket.IO backend port (Vite dev client runs separately on :5173)
PORT=8000

# Postgres — local dev runs in Docker on host port 5433
DB_HOST=localhost
DB_PORT=5433
DB_USER=ouigame
DB_PASSWORD=ouigame
DB_NAME=ouigame

# Google OAuth client ID — from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# Password-reset emails (SMTP, e.g. OVH for pautet.net). Without these the reset
# flow still works end-to-end but the email is skipped (logged to the console
# instead) — fine for local dev. Create a mailbox in your mail host and fill in:
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=ouigame@pautet.net
SMTP_PASS=
# "From" header. With OVH it must be the authenticated mailbox (or one of its
# aliases).
EMAIL_FROM=OuiTank <ouigame@pautet.net>
# Public base URL of the web client, used to build the password-reset link
# (the client uses a HashRouter, so the path is appended after '#'). Local dev:
# the Vite client runs on :5173.
WEB_URL=http://localhost:5173
